{
  "name": "end-pos",
  "productName": "End PoS",
  "version": "1.8.2",
  "description": "Offline point-of-sale app for small shops, built with Electron.",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "smoke": "electron test/smoke.js",
    "bench": "electron test/bench.js"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.shop.endpos",
    "productName": "End PoS",
    "icon": "build/icon",
    "files": [
      "main.js",
      "preload.js",
      "escpos.js",
      "rawprint.js",
      "src/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}
