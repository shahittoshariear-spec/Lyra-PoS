{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lyra PoS",
  "version": "1.8.51",
  "identifier": "com.shariear.lyrapos",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lyra PoS",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "backgroundColor": "#070B16"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "shortDescription": "Offline point-of-sale for small shops",
    "longDescription": "Lyra PoS is an offline point-of-sale app for a small shop. No internet connection is needed, and all data stays on the computer it runs on."
  }
}
